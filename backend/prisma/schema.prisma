// DepGuard Scanner data model — see docs/project_20_dependency_vulnerability_dashboard_guide.md §10.
// Connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  PENDING // created, not started
  RUNNING // parsing / querying OSV
  COMPLETED // every package was checked
  PARTIAL // finished, but some packages could not be checked (e.g. OSV outage)
  FAILED // could not finish (e.g. invalid files)
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  UNKNOWN // advisory gave no severity — never invent one
}

enum FindingStatus {
  OPEN
  RESOLVED
}

enum ReportFormat {
  PDF
  CSV
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans       Scan[]

  @@index([userId])
  @@map("projects")
}

model Scan {
  id             String        @id @default(uuid())
  projectId      String
  status         ScanStatus    @default(PENDING)
  sourceFileName String
  errorMessage   String?
  createdAt      DateTime      @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependencies   Dependency[]
  findings       ScanFinding[]
  reports        Report[]

  @@index([projectId, createdAt])
  @@map("scans")
}

// Stored per scan so each historical scan keeps the exact versions seen at that time.
model Dependency {
  id           String        @id @default(uuid())
  scanId       String
  packageName  String
  ecosystem    String        @default("npm")
  version      String
  isDirect     Boolean
  isDev        Boolean       @default(false)
  lockfilePath String? // e.g. "node_modules/a/node_modules/b"
  scan         Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findings     ScanFinding[]

  @@index([scanId])
  @@index([packageName, version])
  @@map("dependencies")
}

// Shared advisory cache, keyed by OSV id (e.g. GHSA-xxxx-xxxx-xxxx).
model Vulnerability {
  id          String        @id @default(uuid())
  osvId       String        @unique
  aliases     String[] // e.g. CVE ids
  summary     String?
  details     String?
  severity    Severity      @default(UNKNOWN)
  cvssVector  String?
  references  Json?
  publishedAt DateTime?
  modifiedAt  DateTime?
  fetchedAt   DateTime      @default(now())
  findings    ScanFinding[]

  @@map("vulnerabilities")
}

model ScanFinding {
  id              String        @id @default(uuid())
  scanId          String
  dependencyId    String
  vulnerabilityId String
  affectedRange   String?
  fixedVersion    String? // null = advisory gives no fix — show "Not provided"
  status          FindingStatus @default(OPEN)
  createdAt       DateTime      @default(now())
  scan            Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  dependency      Dependency    @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Restrict)

  @@unique([dependencyId, vulnerabilityId])
  @@index([scanId])
  @@map("scan_findings")
}

model Report {
  id          String       @id @default(uuid())
  scanId      String
  format      ReportFormat
  filePath    String
  generatedAt DateTime     @default(now())
  scan        Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("reports")
}
