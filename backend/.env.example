# Copy this file to .env and adjust if needed:  cp .env.example .env

NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (Vite dev server default).
CORS_ORIGIN=http://localhost:5173

# Matches the defaults in ../docker-compose.yml (note host port 5433, not 5432).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://depguard:depguard_dev_password@localhost:5433/depguard?schema=public"
